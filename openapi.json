{
  "openapi": "3.0.0",
  "info": {
    "title": "Flock Energy Urja Meter API",
    "version": "1.0.0",
    "description": "REST API wrapper over Urja Meter Ops legacy portal"
  },
  "servers": [
    {
      "url": "http://localhost:5055"
    }
  ],
  "paths": {
    "/api/v1/meters": {
      "get": {
        "summary": "Get all meters",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "example": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter list"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/energy": {
      "get": {
        "summary": "Get meter energy consumption",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Energy data"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/geo": {
      "get": {
        "summary": "Get meter location",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Geo coordinates"
          }
        }
      }
    }
  }
}